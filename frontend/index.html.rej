   </footer>
 
   <script>
+    const authShell = document.getElementById("auth-shell");
+    const appMain = document.getElementById("app-main");
+    const loginForm = document.getElementById("login-form");
+    const loginButton = document.getElementById("login-button");
+    const bootstrapForm = document.getElementById("bootstrap-form");
+    const bootstrapButton = document.getElementById("bootstrap-button");
+    const authMessage = document.getElementById("auth-message");
+    const logoutButton = document.getElementById("logout-button");
+    const accountName = document.getElementById("account-name");
+
+    function setAuthMessage(text, type = "info") {
+      authMessage.textContent = text;
+      authMessage.className = `message ${type}`;
+    }
+
+    function getCookie(name) {
+      const prefix = `${name}=`;
+      const item = (document.cookie || "").split(";").map((part) => part.trim())
+        .find((part) => part.startsWith(prefix));
+      return item ? decodeURIComponent(item.slice(prefix.length)) : "";
+    }
+
+    function showSignedOut(message = "Sign in with your account to continue.") {
+      authShell.hidden = false;
+      appMain.hidden = true;
+      accountName.hidden = true;
+      logoutButton.hidden = true;
+      setAuthMessage(message, "info");
+    }
+
+    function showSignedIn(user) {
+      authShell.hidden = true;
+      appMain.hidden = false;
+      accountName.textContent = `${user.username} · ${user.role}`;
+      accountName.hidden = false;
+      logoutButton.hidden = false;
+      loadInvestigationHistory();
+    }
+
+    async function apiFetch(resource, options = {}) {
+      const method = (options.method || "GET").toUpperCase();
+      const headers = { ...(options.headers || {}), "Accept": "application/json" };
+      if (!["GET", "HEAD", "OPTIONS"].includes(method)) {
+        const csrfToken = getCookie("paypilot_csrf");
+        if (csrfToken) headers["X-CSRF-Token"] = csrfToken;
+      }
+      const response = await fetch(resource, {
+        ...options,
+        method,
+        headers,
+        credentials: "same-origin"
+      });
+      if (response.status === 401) {
+        showSignedOut("Your session has expired or is no longer valid. Please sign in again.");
+        throw new Error("Your session has expired. Please sign in again.");
+      }
+      return response;
+    }
+
+    loginForm.addEventListener("submit", async (event) => {
+      event.preventDefault();
+      loginButton.disabled = true;
+      loginButton.textContent = "Signing in…";
+      setAuthMessage("Verifying your account…");
+      try {
+        const response = await fetch("/api/auth/login", {
+          method: "POST",
+          credentials: "same-origin",
+          headers: { "Accept": "application/json", "Content-Type": "application/json" },
+          body: JSON.stringify({
+            username: document.getElementById("login-username").value,
+            password: document.getElementById("login-password").value
+          })
+        });
+        const data = await response.json();
+        if (!response.ok || !data.user) {
+          throw new Error(response.status === 401
+            ? "Invalid username or password."
+            : "Sign-in is temporarily unavailable. Check the server and try again.");
+        }
+        loginForm.reset();
+        setAuthMessage("Signed in successfully.", "success");
+        showSignedIn(data.user);
+      } catch (error) {
+        setAuthMessage(error instanceof Error ? error.message : "Sign-in failed.", "error");
+      } finally {
+        loginButton.disabled = false;
+        loginButton.textContent = "Sign in";
+      }
+    });
+
+    document.getElementById("show-bootstrap").addEventListener("click", () => {
+      bootstrapForm.hidden = false;
+      document.getElementById("bootstrap-token").focus();
+    });
+    document.getElementById("hide-bootstrap").addEventListener("click", () => {
+      bootstrapForm.reset();
+      bootstrapForm.hidden = true;
+      setAuthMessage("Initial owner setup was not submitted.");
+    });
+
+    bootstrapForm.addEventListener("submit", async (event) => {
+      event.preventDefault();
+      bootstrapButton.disabled = true;
+      bootstrapButton.textContent = "Creating owner…";
+      setAuthMessage("Creating the initial owner account…");
+      try {
+        const response = await fetch("/api/auth/bootstrap", {
+          method: "POST",
+          credentials: "same-origin",
+          headers: {
+            "Accept": "application/json",
+            "Content-Type": "application/json",
+            "X-Bootstrap-Token": document.getElementById("bootstrap-token").value
+          },
+          body: JSON.stringify({
+            username: document.getElementById("owner-username").value,
+            password: document.getElementById("owner-password").value
+          })
+        });
+        const data = await response.json();
+        if (!response.ok || !data.user) {
+          const detail = response.status === 503
+            ? "Owner setup is not enabled. Configure the bootstrap secret on the server."
+            : response.status === 403
+              ? "The bootstrap secret was not accepted."
+              : response.status === 409
+                ? "An owner already exists or the account details are invalid."
+                : "Owner setup could not be completed.";
+          throw new Error(detail);
+        }
+        bootstrapForm.reset();
+        bootstrapForm.hidden = true;
+        setAuthMessage("Owner account created. You are now signed in.", "success");
+        showSignedIn(data.user);
+      } catch (error) {
+        setAuthMessage(error instanceof Error ? error.message : "Owner setup failed.", "error");
+      } finally {
+        bootstrapButton.disabled = false;
+        bootstrapButton.textContent = "Create owner account";
+      }
+    });
+
+    logoutButton.addEventListener("click", async () => {
+      logoutButton.disabled = true;
+      try {
+        const response = await apiFetch("/api/auth/logout", { method: "POST" });
+        if (!response.ok) throw new Error("Logout could not be completed. Try again.");
+        showSignedOut("You have been securely signed out.");
+      } catch (error) {
+        setAuthMessage(error instanceof Error ? error.message : "Logout failed.", "error");
+      } finally {
+        logoutButton.disabled = false;
+      }
+    });
+
+    async function restoreSession() {
+      try {
+        const response = await fetch("/api/auth/me", {
+          method: "GET", credentials: "same-origin",
+          headers: { "Accept": "application/json" }
+        });
+        if (!response.ok) {
+          showSignedOut();
+          return;
+        }
+        const data = await response.json();
+        if (!data.user || !data.user.username || !data.user.role) {
+          showSignedOut("Your session could not be verified. Please sign in again.");
+          return;
+        }
+        showSignedIn(data.user);
+      } catch {
+        showSignedOut("Unable to contact PayPilot. Check the server connection and sign in again.");
+      }
+    }
+
     const form = document.getElementById("investigation-form");
     const orderInput = document.getElementById("order-id");
     const button = document.getElementById("investigate-button");
