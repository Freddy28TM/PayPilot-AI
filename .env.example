# Copy to .env and fill in locally. Never commit .env.
# PayPilot AI is restricted to the PayPal Sandbox.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional: AI explanation providers (deterministic fallback is used if unset).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional: keep the database, backups, logs, exports and recovery copies
# outside the source repository. Must be an absolute path. If unset, the
# legacy in-repository data/ directory is used.
# PAYPILOT_DATA_DIR=/data/paypilot-data
